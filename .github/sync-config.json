{
  "description": "Configuration for automated sync from private to public repository.",
  "exclude_pathspecs": [
    ":!internal/",
    ":!docs/",
    ":!.azure-pipelines/",
    ":!.github/",
    ":!CONTRIBUTING.md",
    ":!README.md",
    ":!public-overlay/"
  ],
  "exclude_basenames": [
    ".ci-skip",
    ".code-ci-skip"
  ],
  "protected_paths": [
    ".github/workflows/mirror-back.yml",
    ".github/workflows/run-setup.yml"
  ],
  "public_repo": {
    "owner": "microsoft-foundry",
    "name": "foundry-samples"
  },
  "sync_branch_prefix": "sync/private-to-public"
}
