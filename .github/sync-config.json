{
  "description": "Configuration for automated sync from private to public repository.",
  "default_include_paths": [
    "infrastructure/",
    "samples/"
  ],
  "exclude_pathspecs": [
    ":!internal/",
    ":!docs/",
    ":!.azure-pipelines/",
    ":!.github/",
    ":!CONTRIBUTING.md",
    ":!README.md",
    ":!public-overlay/"
  ],
  "exclude_basenames": [
    ".ci-skip",
    ".code-ci-skip"
  ],
  "public_repo": {
    "owner": "microsoft-foundry",
    "name": "foundry-samples"
  },
  "sync_branch_prefix": "sync/private-to-public"
}
